# ===== Database =====
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
PORT=3000

# ===== Security & SSO =====
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Microsoft Entra ID (Azure AD) — from portal.azure.com App Registration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Comma-separated emails auto-promoted to Admin on first SSO login
ADMIN_EMAILS=hello@mayvel.ai
# Restrict sign-in to this email domain (empty = any user in your Azure tenant)
ALLOWED_EMAIL_DOMAIN=

# ===== URLs =====
# Production: https://erp.mayvel.ai for all three
CORS_ORIGIN=http://localhost:5173
SERVER_URL=http://127.0.0.1:3000
APP_URL=http://localhost:5173

# ===== Notion sync (optional) =====
NOTION_TOKEN=
NOTION_TASKS_DB=

# ===== File storage (avatars + task attachments) =====
# Pick ONE:
#   FILE_STORAGE=gridfs  -> store files in MongoDB (no extra vendor or cost;
#                           survives redeploys; uses your DB storage quota)
#   S3_* vars below      -> store in an S3-compatible bucket (R2/B2/S3/MinIO)
#   neither              -> local disk (dev only; wiped on redeploy)
FILE_STORAGE=gridfs

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ===== Email invites (optional) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
