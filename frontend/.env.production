# Production build config (committed — contains no secrets).
# The API is served by the same origin (erp.mayvel.ai), so a relative path works everywhere.
VITE_API_URL=/api

# Azure public client/tenant IDs are injected at build time by the host's env vars:
# set VITE_AZURE_CLIENT_ID and VITE_AZURE_TENANT_ID in the Hostinger dashboard.
# (Values in the host environment override this file; these are placeholders.)
